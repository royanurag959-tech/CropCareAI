# CropCare AI Environment Variables
PROJECT_NAME="CropCare AI"
VERSION="1.0.0"
SECRET_KEY="replace-this-with-a-secure-random-jwt-secret-in-production"
DEMO_MODE="true"

# Database: Default SQLite; Change to PostgreSQL in production:
# DATABASE_URL="postgresql://user:password@localhost:5432/cropcare"
DATABASE_URL="sqlite:///./cropcare.db"

# Storage
STORAGE_DIR="./uploaded_scans"

# Quotas
FREE_TIER_MONTHLY_LIMIT=5
PLUS_TIER_MONTHLY_LIMIT=50
PRO_TIER_MONTHLY_LIMIT=500
